# 复制为 web/.env.local 或部署环境变量（勿提交密钥）

# 推荐：Cloudflare Worker（见 ../workers/guest-verify-email）
# VITE_GUEST_VERIFY_EMAIL_API=https://guest-verify-email.<subdomain>.workers.dev

# 或 EmailJS（静态站直连；模板变量：to_email / code / company / contact_name / country / subject / message）
# VITE_EMAILJS_SERVICE_ID=
# VITE_EMAILJS_TEMPLATE_ID=
# VITE_EMAILJS_PUBLIC_KEY=
